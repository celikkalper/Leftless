    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless benötigt dies, um Dateien zu bewegen, für die Administratorrechte erforderlich sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless needs this to move files that require administrator permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless lo necesita para trasladar archivos que requieren permiso de administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless en a besoin pour déplacer les fichiers qui nécessitent une autorisation d'administrateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者の許可が必要なファイルを移動するために使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leftless precisa disso para mover arquivos que exigem permissão de administrador."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici izni gerektiren dosyaları taşımak için"
          }
        }
      }
    }
