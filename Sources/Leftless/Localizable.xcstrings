    "Restore the copy from the Trash? If you choose Replace, the existing item will be moved to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie aus dem Papierkorb wiederherstellen? Wenn du „Ersetzen“ wählst, wird das vorhandene Objekt in den Papierkorb gelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Restaurar la copia de la Papelera? Si eliges Reemplazar, el ítem existente se trasladará a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurer la copie depuis la corbeille ? Si vous choisissez Remplacer, l'élément existant sera placé dans la corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱にあるコピーを復元しますか？“置き換える”を選択すると、既存の項目はゴミ箱に入れられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar a cópia do Lixo? Se você escolher Substituir, o item existente será movido para o Lixo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepeti'ndeki kopya geri yüklensin mi? Değiştir derseniz mevcut öğe Çöp Sepeti'ne taşınır."
          }
        }
      }
    },
