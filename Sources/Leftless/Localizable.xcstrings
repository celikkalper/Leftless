    "A system extension from this app or its developer was found. macOS removes it in System Settings > General > Login Items & Extensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde eine Systemerweiterung dieser App oder ihres Entwicklers gefunden. macOS entfernt sie unter „Systemeinstellungen“ > „Allgemein“ > „Anmeldeobjekte und Erweiterungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha encontrado una extensión del sistema de esta app o de su desarrollador. macOS la elimina en Ajustes del Sistema > General > Ítems de inicio y extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une extension système de cette app ou de son développeur a été trouvée. macOS la supprime dans Réglages Système > Général > Ouverture et extensions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリまたはその開発元のシステム機能拡張が見つかりました。macOSでは「システム設定」>「一般」>「ログイン項目と機能拡張」で削除します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma extensão do sistema deste app ou do seu desenvolvedor foi encontrada. O macOS a remove em Ajustes do Sistema > Geral > Itens de Início e Extensões."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamaya veya üreticisine ait bir sistem uzantısı bulundu; macOS bunu Sistem Ayarları > Genel > Giriş Öğeleri ve Uzantılar üzerinden kaldırır."
          }
        }
      }
    },
