    "Leftless can't read the Trash. Check Full Disk Access, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless kann den Papierkorb nicht lesen. Prüfe den Festplattenvollzugriff und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless no puede leer la Papelera. Comprueba el acceso total al disco y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless ne peut pas lire la corbeille. Vérifiez l'accès complet au disque, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftlessはゴミ箱を読み取れません。フルディスクアクセスを確認してから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leftless não consegue ler o Lixo. Verifique o acesso total ao disco e tente novamente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless Çöp Sepeti'ni okuyamıyor. Tam Disk Erişimi'ni kontrol edip yeniden deneyin."
          }
        }
      }
    },
    "Leftless couldn't be added to Login Items, so it watches only while it's open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless konnte nicht zu den Anmeldeobjekten hinzugefügt werden und überwacht daher nur, solange es geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido añadir Leftless a Ítems de inicio, así que solo vigila mientras está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless n'a pas pu être ajouté à Ouverture ; il surveille donc uniquement lorsqu'il est ouvert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftlessをログイン項目に追加できませんでした。そのため、開いている間だけ監視します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível adicionar o Leftless aos Itens de Início, então ele monitora apenas enquanto estiver aberto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless Giriş Öğeleri'ne eklenemedi; bu nedenle yalnızca açıkken izler."
          }
        }
      }
    },
    "Leftless looks in your Library for files left behind by apps that are no longer on this Mac. Nothing is selected or moved until you choose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless sucht in deiner Library nach Dateien von Apps, die nicht mehr auf diesem Mac sind. Nichts wird ausgewählt oder bewegt, bevor du es entscheidest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless busca en tu Biblioteca archivos que dejaron apps que ya no están en este Mac. No se selecciona ni se traslada nada hasta que tú lo decidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless recherche dans votre Bibliothèque les fichiers laissés par des apps qui ne sont plus sur ce Mac. Rien n'est sélectionné ni déplacé sans votre choix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless は、このMacにもう存在しないアプリが残したファイルをライブラリから探します。選択するまで何も選択・移動されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leftless procura na sua Biblioteca arquivos deixados por apps que não estão mais neste Mac. Nada é selecionado nem movido até você escolher."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless, Kitaplık klasörünüzde artık bu Mac'te olmayan uygulamalardan kalan dosyaları arar. Siz seçmedikçe hiçbir şey seçilmez veya taşınmaz."
          }
        }
      }
    },
    "Leftless needs Full Disk Access to see what's in the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless benötigt Festplattenvollzugriff, um den Inhalt des Papierkorbs zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless necesita acceso total al disco para ver lo que hay en la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless a besoin de l'accès complet au disque pour voir le contenu de la corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱の中身を確認するには、Leftlessにフルディスクアクセスが必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leftless precisa de acesso total ao disco para ver o que há no Lixo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless'ın Çöp Sepeti'ndekileri görebilmesi için Tam Disk Erişimi gerekir."
          }
        }
      }
    },
