    "A system extension from this app or its developer was found. macOS removes it in System Settings > General > Login Items & Extensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde eine Systemerweiterung dieser App oder ihres Entwicklers gefunden. macOS entfernt sie unter „Systemeinstellungen“ > „Allgemein“ > „Anmeldeobjekte und Erweiterungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha encontrado una extensión del sistema de esta app o de su desarrollador. macOS la elimina en Ajustes del Sistema > General > Ítems de inicio y extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une extension système de cette app ou de son développeur a été trouvée. macOS la supprime dans Réglages Système > Général > Ouverture et extensions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリまたはその開発元のシステム機能拡張が見つかりました。macOSでは「システム設定」>「一般」>「ログイン項目と機能拡張」で削除します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma extensão do sistema deste app ou do seu desenvolvedor foi encontrada. O macOS a remove em Ajustes do Sistema > Geral > Itens de Início e Extensões."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamaya veya üreticisine ait bir sistem uzantısı bulundu; macOS bunu Sistem Ayarları > Genel > Giriş Öğeleri ve Uzantılar üzerinden kaldırır."
          }
        }
      }
    },
    "Add Leftless with + and turn it on" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leftless mit + hinzufügen und aktivieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade Leftless con + y actívalo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez Leftless avec + et activez-le"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ でLeftlessを追加してオンにする"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o Leftless com + e ative-o"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ ile Leftless'ı ekle ve aç"
          }
        }
      }
    },
    "Allow Leftless in Login Items so it can keep watching after you log in. Until then, it watches while it's open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Leftless unter „Anmeldeobjekte“, damit es nach der Anmeldung weiter überwachen kann. Bis dahin überwacht es nur, solange es geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Leftless en Ítems de inicio para que siga vigilando después de iniciar sesión. Hasta entonces, solo vigila mientras está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Leftless dans Ouverture pour qu'il continue la surveillance après l'ouverture de session. D'ici là, il surveille uniquement lorsqu'il est ouvert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン後も監視を続けられるように、「ログイン項目」でLeftlessを許可してください。それまでは、開いている間だけ監視します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Leftless em Itens de Início para que ele continue monitorando depois que você iniciar a sessão. Até lá, ele monitora apenas enquanto estiver aberto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açtıktan sonra da izlemeye devam edebilmesi için Giriş Öğeleri'nde Leftless'a izin verin. O zamana kadar yalnızca açıkken izler."
          }
        }
      }
    },
