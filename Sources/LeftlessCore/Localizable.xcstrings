    "%@ will be moved to the Trash (%@). You can undo this from History." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgendes wird in den Papierkorb gelegt: %1$@ (%2$@). Du kannst dies im Verlauf widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will be moved to the Trash (%2$@). You can undo this from History."
          }
